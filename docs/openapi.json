  "components": {
    "schemas": {
      "ConsolidateRequest": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "source_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\w.:-]+$"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope",
          "source_ids"
        ],
        "title": "ConsolidateRequest"
      },
      "ConsolidateResponse": {
        "properties": {
          "memories": {
            "items": {
              "$ref": "#/components/schemas/Memory"
            },
            "type": "array",
            "title": "Memories"
          },
          "method": {
            "type": "string",
            "enum": [
              "extractive",
              "deepseek"
            ],
            "title": "Method"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "memories",
          "method"
        ],
        "title": "ConsolidateResponse"
      },
      "ContextRequest": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[\\w.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "kinds": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "working",
                    "episodic",
                    "semantic",
                    "procedural"
                  ]
                },
                "type": "array",
                "maxItems": 4,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Kinds"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 8
          },
          "max_chars": {
            "type": "integer",
            "maximum": 32000.0,
            "minimum": 256.0,
            "title": "Max Chars",
            "default": 6000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope",
          "query"
        ],
        "title": "ContextRequest"
      },
      "ContextResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/RecallHit"
            },
            "type": "array",
            "title": "Hits"
          },
          "retrieval_mode": {
            "type": "string",
            "title": "Retrieval Mode"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "context": {
            "type": "string",
            "title": "Context"
          },
          "included_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Included Ids"
          },
          "chars_used": {
            "type": "integer",
            "title": "Chars Used"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hits",
          "retrieval_mode",
          "context",
          "included_ids",
          "chars_used"
        ],
        "title": "ContextResponse"
      },
      "DeleteResponse": {
        "properties": {
          "deleted_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Deleted Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deleted_ids"
        ],
        "title": "DeleteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\w.:-]+$",
            "title": "Event Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\w.:-]+$",
            "title": "Session Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Messages"
          },
          "extract": {
            "type": "boolean",
            "title": "Extract",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope",
          "event_id",
          "session_id",
          "messages"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "memories": {
            "items": {
              "$ref": "#/components/schemas/Memory"
            },
            "type": "array",
