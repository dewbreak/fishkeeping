# Copy to .env; never commit credentials or memory data.
# Relative database paths are resolved from the process working directory.
FISHKEEPING_DB_PATH=data/fishkeeping.sqlite3
FISHKEEPING_HOST=127.0.0.1
FISHKEEPING_PORT=8765
FISHKEEPING_REQUEST_TIMEOUT=45
FISHKEEPING_CANDIDATE_LIMIT=5000
FISHKEEPING_WORKER_DAILY_CALL_LIMIT=20
FISHKEEPING_WORKER_MAX_ATTEMPTS=3

# Empty map disables authentication: use only in a trusted local environment.
# Otherwise map each random API token (at least 16 characters) to one namespace.
FISHKEEPING_API_KEYS={}
# FISHKEEPING_API_KEYS='{"replace-with-a-random-token-at-least-16-chars":"personal"}'

# Optional DeepSeek extraction and consolidation. Leave the key UNSET if unused.
FISHKEEPING_DEEPSEEK_BASE_URL=https://api.deepseek.com
FISHKEEPING_DEEPSEEK_MODEL=deepseek-flash
FISHKEEPING_DEEPSEEK_THINKING=disabled
FISHKEEPING_DEEPSEEK_MAX_TOKENS=2048
# FISHKEEPING_DEEPSEEK_API_KEY=replace-with-your-provider-key

# POST /v1/events persists immediately; start a separate worker to extract.
# Daily attempt budget above is shared by all workers using this DB, reset at UTC midnight.
# It does not cap synchronous ingest, consolidation, chat, or remote embedding calls.
# uv run fishkeeping worker --once

# Optional OpenAI-compatible embedding service, configured separately.
# Set URL and model; a key is optional for a trusted local embedding server.
FISHKEEPING_EMBEDDING_BACKEND=remote
# FISHKEEPING_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# FISHKEEPING_EMBEDDING_MODEL=your-embedding-model
# FISHKEEPING_EMBEDDING_API_KEY=replace-with-your-embedding-key
# FISHKEEPING_EMBEDDING_MIN_SIMILARITY=0.35

# Optional local multilingual CPU embeddings; leave disabled for the default lexical setup.
# Install with uv sync --extra local --locked; retain --extra local on EVERY uv run.
# First encoding downloads the pinned model (about 252 MB); subsequent use reuses the cache.
# FISHKEEPING_EMBEDDING_BACKEND=local
# FISHKEEPING_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# FISHKEEPING_LOCAL_EMBEDDING_CACHE=.cache/embeddings
# FISHKEEPING_LOCAL_EMBEDDING_THREADS=2
# FISHKEEPING_LOCAL_EMBEDDING_MIN_SIMILARITY=0.50
# uv run --extra local fishkeeping index --namespace personal --user-id alice --agent-id assistant --batch-size 64 --max-batches 20
# Recall never builds document vectors. Index explicitly; --rebuild clears only this scope/model.
